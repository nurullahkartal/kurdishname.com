{
  "name": "kurdishname",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-names-data.ts && tsx scripts/build-search-index.ts && tsx scripts/build-sitemaps.ts",
    "build": "next build",
    "build:verify": "tsx scripts/build-names-data.ts && tsx scripts/build-search-index.ts && tsx scripts/build-sitemaps.ts && node -e \"require('child_process').execSync('npx next build', {stdio:'inherit', env:{...process.env, SSG_BUILD_GROUP:'verify'}})\"",
    "build:all": "cross-env NODE_OPTIONS=--max-old-space-size=8192 SSG_BUILD_GROUP=all next build",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "next": "^15.2.0",
    "next-intl": "~4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
