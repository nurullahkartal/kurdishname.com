{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "cross-env SKIP_PWA=true vite build && tsx scripts/build.ts",
    "build:prod": "vite build && tsx scripts/build.ts",
    "deploy": "npx wrangler pages deploy dist --project-name=kurdishname --branch=kurdishname --commit-dirty=true",
    "preview": "vite preview",
    "clean": "rm -rf dist .cache",
    "lint": "tsc --noEmit",
    "build:legacy": "vite build && tsx scripts/generateSSG.ts",
    "build:safe": "vite build && tsx scripts/buildAll.ts && tsx scripts/validateBuild.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "puppeteer": "^25.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
