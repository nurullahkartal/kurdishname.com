/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), display-capture=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'sha256-xVkVdRiHLO0tKiG+9RmF152YgORhW21+8I6PkeOtpjk=' https://*.cloudflare.com https://*.cloudflareinsights.com https://*.google.com https://*.gstatic.com https://*.google-analytics.com https://*.googletagmanager.com https://*.yandex.ru https://*.yandex.com https://*.yandex.net https://*.bing.com https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.google.com https://*.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://*.gstatic.com; img-src 'self' data: https://kurdishname.com https://*.google.com https://*.gstatic.com https://*.google-analytics.com https://*.cloudflare.com https://*.yandex.ru https://*.yandex.com https://*.yandex.net https://*.bing.com; frame-src 'self' https://*.google.com https://*.cloudflare.com https://challenges.cloudflare.com https://*.yandex.ru https://*.yandex.com https://*.bing.com; connect-src 'self' https://*.cloudflare.com https://*.cloudflareinsights.com https://*.google.com https://*.google-analytics.com https://*.yandex.ru https://*.yandex.com https://*.yandex.net https://*.bing.com https://*.clarity.ms; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;

# Sitemap ve arama indeksi: arama motorları okusun ama tarayıcı cross-origin istekleri kısıtlansın
/sitemap*.xml
  Access-Control-Allow-Origin: https://kurdishname.com
  Cross-Origin-Resource-Policy: same-site

/search_index.json
  Access-Control-Allow-Origin: https://kurdishname.com
  Cross-Origin-Resource-Policy: same-site

# API uç noktaları: sadece kendi domain'inden istek kabul et
/api/*
  Access-Control-Allow-Origin: https://kurdishname.com
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Cross-Origin-Resource-Policy: same-site

# Varlık Koruması: /assets/ altındaki CSS ve JS dosyalarının harici sitelerden yüklenmesini engelle
/assets/*
  Access-Control-Allow-Origin: https://kurdishname.com
  Cross-Origin-Resource-Policy: same-origin
