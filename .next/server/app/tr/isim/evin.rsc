,"lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Evet, Evîn ismi geleneksel olarak Kız kız ismi olarak kullanılmaktadır. Bu kullanım Kürtçe isim geleneğiyle tamamen uyumludur."}]]}],["$","div","3",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Evîn ismi Kuran'da geçiyor mu, caiz midir?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Kuran-ı Kerim'de geçmeyen bu isim, Kürt kültürünün doğa ve yaşam felsefesinden doğmuştur. Dini kısıtlaması bulunmamaktadır."}]]}],["$","div","4",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Evîn ismi taşıyan biri nasıl bir karaktere sahiptir?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Evîn ismine göre yapılan kültürel analize göre bu ismi taşıyan kişiler; sevgi dolu, zarif ve insanların kalbine kolayca dokunan sıcak bir karakter taşır. Çevresine güzellik ve huzur yayar. E harfiyle başlayan isimler genellikle özgürlük sevgisi, merak ve uyum yeteneği özelliklerini ön plana çıkarır."}]]}],["$","div","5",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Evîn isminin harf analizi nedir?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Evîn ismi 4 harften oluşmaktadır. 4 harfli isimler numerolojide kararlılık, disiplin ve güvenilirlik enerjisi ile ilişkilendirilir. Ayrıca E harfi; özgürlük sevgisi, merak ve uyum yeteneği enerjisini temsil eder."}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
