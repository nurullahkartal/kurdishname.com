leri.","blog3_content":"$25","admin_login_title":"Admin Panel","admin_login_desc":"Yönetim paneline giriş yapın","admin_username":"Kullanıcı Adı","admin_password":"Şifre","admin_login_btn":"Giriş Yap","admin_invalid_creds":"Geçersiz kullanıcı adı veya şifre","admin_menu_dashboard":"Dashboard","admin_menu_names":"İsim Listesi","admin_menu_settings":"Site Ayarları","admin_menu_logout":"Çıkış Yap","admin_menu_goto_site":"Siteye Git","admin_dash_title":"Dashboard Özet","admin_dash_total":"Toplam İsim","admin_dash_girls":"Kız İsimleri","admin_dash_boys":"Erkek İsimleri","admin_dash_multilang":"Çoklu Dil Desteği","admin_dash_lang_dist":"Dil Dağılımı","admin_dash_db_ready":"Veritabanı Hazır Mimaride","admin_dash_db_desc":"Mevcut liste yapıları, localStorage üzerinden geçici CRUD işlemlerini simüle etmektedir. Gerçek ortam için Firebase veya PostgreSQL gibi bir backend bağlantısı yapmanız yeterlidir.","admin_names_title":"İsim Listesi","admin_names_add":"Yeni İsim Ekle","admin_names_search":"İsim ara...","admin_names_all_genders":"Tüm Cinsiyetler","admin_names_female":"Kız","admin_names_male":"Erkek","admin_names_both":"Ortak","admin_names_col_name":"İsim","admin_names_col_meaning":"Anlam","admin_names_col_gender":"Cinsiyet","admin_names_col_actions":"İşlemler","admin_names_confirm_delete":"Bu ismi silmek istediğinize emin misiniz?","admin_names_empty":"Kayıt bulunamadı.","admin_names_limit":"Gösterilen liste 50 kayıt ile sınırlandırılmıştır. Toplam: {count}","admin_settings_title":"Site Ayarları","admin_settings_save":"Ayarları Kaydet","admin_settings_saved":"Kaydedildi","admin_settings_seo_tr":"Genel SEO & Başlık (Türkçe)","admin_settings_seo_en":"Genel SEO & Başlık (İngilizce)","admin_settings_site_title":"Site Başlığı (Title)","admin_settings_site_desc":"Açıklama (Meta Description)","admin_settings_sys":"Sistem Ayarları","admin_settings_maint":"Bakım Modu (Site ziyarete kapanır)","gender_female":"Kız","gender_male":"Erkek","gender_both":"Ortak","gender_unisex":"Unisex","not_found":"İsim Bulunamadı","default_origin":"Kürtçe","no_meaning":"Bu ismin anlamı henüz eklenmemiştir. Ancak Kürtçe kültürel mirasta önemli bir yeri vardır.","seo_keywords_names":"{name} isminin anlamı, Kürtçe isimler, Kürtçe {genderText} isimleri","seo_name_title":"{name} Kürtçe Ne Demek? {name} İsminin Anlamı ve Kökeni","detail_meaning_rich":"{name} Kürtçe Ne Demek? {name} İsminin Anlamı","detail_origin_rich":"{name} İsminin Kökeni Nedir? Kürtçe Bebek İsimleri ve Etimolojisi","detail_gender_rich":"{name} İsminin Cinsiyeti ve Karakter Analizi","detail_gender_desc":"{name} ismi modern Kürtçe {genderText} isimleri kategorisinde yer almaktadır. Genellikle {genderText} bebekler için tercih edilen {name} ismi, taşıdığı asil anlam ve melodik telaffuzu ile Kürtçe bebek isimleri arasında en popüler ve modern seçeneklerden biridir.","detail_similar_rich":"{name} Benzeri Modern Kürtçe {genderText} İsimleri","seo_blog_keywords":"Kürtçe isimler, bebek isimleri, blog","seo_blog_desc":"Kürtçe isim seçimi, kültürel kökenler, modern bebek isimleri ve dil etimolojisi hakkında en kapsamlı blog ve uzman rehber yazıları.","theme_nature":"Doğa, Ağaç, Çiçek","theme_power":"Güç, Cesaret, Kahramanlık","theme_beauty":"Aşk, Güzellik, Narin","theme_light":"Güneş, Işık, Aydınlık","theme_wisdom":"Bilgelik, Akıl, Başarı","theme_mixed":"Karışık (Önemi Yok)","cat_all_themes":"Tüm Temalar","search_placeholder":"10.000+ isim arasında ara...","trends_title":"Haftalık Trendler & Popüler İsimler","trends_desc":"Bu hafta en çok favoriye eklenen ve incelenen gözde Kürtçe bebek isimleri.","trends_live":"CANLI","suggest":"isim-oner","suggest_badge":"ARŞİV GENİŞLETİCİ","suggest_title":"Yeni İsim Öner","suggest_seo_title":"Yeni Kürtçe İsim Öner","suggest_seo_desc":"Sitede bulamadığınız Kürtçe isimleri anlamları ve cinsiyet bilgileriyle bize gönderin, veritabanımızı birlikte büyütelim.","suggest_desc":"Sitede bulamadığınız Kürtçe isimleri bizimle paylaşın. Akademik incelemeden sonra en kısa sürede veritabanına ekleyelim.","suggest_label_name":"Önerilen İsim","suggest_placeholder_name":"Örn: Arîn, Alend...","suggest_label_gender":"Cinsiyet","suggest_label_meaning":"Anlamı ve Notlar","suggest_placeholder_meaning":"İsmin bildiğiniz anlamı, kaynak kitabı veya tarihi referansı...","suggest_label_email":"E-Posta Adresiniz (İsteğe Bağlı)","suggest_opt_in":"Bu isim arşive eklendiğinde bana e-posta ile haber ver ve gelişmeleri paylaş.","suggest_btn_submit":"Öneriyi Gönder","suggest_success_title":"Öneriniz Alındı!","suggest_success_desc":"Önerdiğiniz ismi akademik olarak inceleyip doğruluğunu onayladıktan sonra arşive dahil edeceğiz. Kürtçe isim kültürünü birlikte yaşattığımız için teşekkürler!","suggest_another":"Başka Bir İsim Öner","compare":"karsilastir","nav_compare":"Karşılaştır","compare_seo_title":"İsim Karşılaştırma & Kıyaslama Robotu","compare_seo_desc":"En beğendiğiniz Kürtçe isimleri anlamı, kökeni, popülerliği ve harf uyumu açısından yan yana karşılaştırın, en doğru kararı verin.","compare_badge":"KARAR DESTEK MEKANİZMASI","compare_title":"İsim Karşılaştırma Modülü","compare_desc":"Kararsız mı kaldınız? En çok beğendiğiniz iki Kürtçe ismi yan yana koyun; anlamları, cinsiyetleri ve harf yapılarıyla kıyaslayıp en doğru kararı verin!","compare_label_1":"1. İsim","compare_label_2":"2. İsim","compare_placeholder":"Karşılaştırmak istediğiniz ismi arayın...","compare_harmony_score":"İsimlerin Akustik Uyum Oranı","compare_harmony_desc":"İsimlerin harf uzunlukları ve ses benzerlikleri uyum katsayısı.","compare_stat_length":"Harf Sayısı","compare_stat_meaning":"Anlamı","compare_stat_origin":"Köken","compare_stat_gender":"Cinsiyet","compare_stat_popularity":"Trend Seviyesi","compare_quick_fav":"Defterimdeki İsimlerden Hızlıca Seç:","compare_empty_title":"Kıyaslanacak İsim Seçilmedi","compare_empty_desc":"Yukarıdaki kutulardan kıyaslamak istediğiniz iki ismi aratın veya defterinizdeki isimlerden hızlıca seçip kıyaslayın!","harmony_good":"Güzel Uyum","harmony_perfect":"Kusursuz Uyum!","harmony_neutral":"Uyumlu Yapıda","select_first_name":"Lütfen birinci ismi seçin","select_second_name":"Lütfen ikinci ismi seçin","clear_comparison":"Karşılaştırmayı Temizle","favorites_compare_cta_title":"Defterinizdeki İsimleri Karşılaştırın","favorites_compare_cta_desc":"Defterinize eklediğiniz isimleri yan yana koyup anlamları ve harf uyumlarıyla kıyaslayın.","favorites_compare_cta_btn":"Hemen Karşılaştır","search_suggest_cta_title":"Aradığınız ismi bulamadınız mı?","search_suggest_cta_desc":"Aradığınız Kürtçe isim arşivimizde henüz yer almıyor olabilir. Hemen bize önerin, akademik incelemenin ardından veritabanımıza ekleyelim!","cat_theme_nature":"Doğa / Yaşam","cat_theme_power":"Cesaret / Güç","cat_theme_beauty":"Sevgi / Güzellik","aria_search_label":"İsim ara","aria_search_button":"Ara","aria_lang_switch":"{lang} diline geç","aria_nav_label":"Site navigasyonu","cat_theme_light":"Işık / Aydınlık","cat_theme_wisdom":"Bilgelik / Akıl","theme_nature_title":"Kürtçe Doğa ve Tabiat İsimleri","theme_nature_desc":"Doğadan, ağaçlardan, çiçeklerden ve yaşamın canlılığından ilham alan en güzel Kürtçe bebek isimleri ve anlamları.","theme_power_title":"Kürtçe Güç ve Cesaret İsimleri","theme_power_desc":"Güç, cesaret, yiğitlik, kahramanlık ve asalet bildiren en görkemli Kürtçe isimler ve anlamları.","theme_beauty_title":"Kürtçe Sevgi ve Güzellik İsimleri","theme_beauty_desc":"Aşk, sevgi, zarafet, narinlik ve güzellik anlamına gelen en popüler Kürtçe kız ve erkek isimleri.","theme_light_title":"Kürtçe Işık ve Aydınlık İsimleri","theme_light_desc":"Güneş, ışık, yıldız, parlaklık, şafak vakti ve aydınlık saçan en anlamlı Kürtçe bebek isimleri.","theme_wisdom_title":"Kürtçe Bilgelik ve Akıl İsimleri","theme_wisdom_desc":"Bilgelik, akıl, zeka, asalet, vizyon ve başarıyı temsil eden Kürtçe isimler ve Türkçe anlamları.","theme_nature_intro":"Doğa temalı Kürtçe isimler, Mezopotamya'nın binlerce yıllık kültürel hafızasından beslenerek günümüze ulaşmış en köklü isim geleneğini oluşturmaktadır. Dağların heybeti, nehirlerin berraklığı ve baharın coşkusunu tek bir isme sığdıran bu isimler; hem fonetik güzellikleriyle hem de taşıdıkları derin doğa metaforlarıyla Kürt kültürünün ruhunu yansıtır. Kürtçe'de bir ağacın, çiçeğin ya da dağ çayının adını taşımak; yalnızca bir isim değil, bir yaşam felsefesi ve derin bir kültürel bağ kurmak demektir.","theme_power_intro":"Güç ve cesaret temalı Kürtçe isimler; tarihin derinliklerinden süzülerek gelen destansı bir kültürün, Mezopotamya'nın sarp dağlarında yankılanan yiğitlik türkülerinin ve sarsılmaz bir karakter anlayışının simgesidir. Bu isimler, yalnızca kuvveti değil; onuru, adaleti ve asaleti de içinde barındırır. Kürt mitolojisi ve destanları, bu güçlü isimlerin kaynaklarını şekillendirmiş; her isim, bir kahramanın ruhunu ve bir halkın direnç geleneğini nesiller boyu taşımayı amaçlamıştır.","theme_beauty_intro":"Güzellik ve sevgi temalı Kürtçe isimler, Kürt şiirinin en naif imgelerinden ve Mezopotamya'nın kadim aşk hikâyelerinden doğmuştur. 'Evîn' (sevgi) ve 'Hêvî' (umut) gibi sözcüklerle örülü bu isimler; sadece estetik bir güzelliği değil, ruhun derinliklerinden taşan bir zarafeti ve sıcaklığı da yansıtır. Kürt kültüründe sevgiye verilen isimler, çocuğun dünyaya açılan ilk kapısı ve ailenin ona sunduğu en değerli armağan olarak görülmüştür.","theme_light_intro":"Işık temalı Kürtçe isimler, güneşin Zagros dağlarının zirvelerini aydınlatmasından ve yıldızların Mezopotamya ovalarında parlayışından ilham alan bir kültürün eşsiz armağanıdır. Kürt edebiyatında ışık; umudun, bilginin ve özgürlüğün evrensel metaforudur. 'Ronahî' (aydınlık), 'Sterk' (yıldız) ve 'Rojda' (güneşin doğuşu) gibi isimler; çocuğa bir isim vermekten öte, ona aydınlık bir gelecek ve ışıl ışıl bir kader dilemek anlamına gelir.","ctx_share_text":"Bu siteye bir göz at!","ctx_share":"İsmi Paylaş","ctx_copy":"Kopyala","ctx_home":"Ana Sayfaya Dön","spelling_arabic":"Arap Alfabesi (Sorani/Kurmanji)","spelling_latin":"Latin Alfabesi","spelling_cyrillic":"Kiril Alfabesi","spelling_etymology":"Etimoloji ve Kültürel Kökler","brand_prefix":"Kurdish Names","finder_step_gender":"Cinsiyet","finder_step_theme":"Tema","finder_step_letter":"Harf","finder_step_results":"Sonuçlar","finder_analyzing":"İsimler analiz ediliyor...","finder_intro_title":"İsim Bulmaya Hazır mısınız?","finder_intro_desc":"Sizin için en anlamlı Kürtçe isimleri adım adım akıllı algoritmamızla keşfedin.","finder_step":"Adım","finder_empty_hint":"Filtre detaylarınızı değiştirerek tekrar deneyebilirsiniz.","about_title":"Hakkımızda","about_seo_desc":"KurdishName'in misyonu, vizyonu ve 10.000'den fazla Kürtçe isim arşivi hakkında bilgi edinin.","about_vision_title":"Misyon ve Vizyonumuz","about_vision_p":"KurdishName, kültürel mirasın en değerli parçası olan isimlerin korunması, belgelenmesi ve gelecek nesillere doğru bir şekilde aktarılması amacıyla kurulmuştur. Dünyanın en kapsamlı 4 dilli Kürtçe isim kütüphanesi olarak, her ismin etimolojik kökenini, kültürel manasını ve fonetik yapısını bilimsel standartlarda ele alıyoruz.","about_archive_title":"Kapsamlı İsim Arşivi","about_archive_p":"Veritabanımızda Kurmanci, Sorani, Zazaki ve Kelhuri gibi Kürtçe lehçelerinden derlenmiş 10.000'den fazla özgün isim yer almaktadır. Her ismin arkasındaki doğa, bilgelik, sevgi ve asalet gibi kadim temaları modern bir arayüzle kullanıcılarımıza sunuyoruz.","about_trans_title":"Çok Dilli ve Güvenilir Rehber","about_trans_p":"KurdishName; Türkçe, İngilizce, Almanca ve Arapça dillerinde tam senkronize destek sunmaktadır. Amacımız, dünyanın neresinde olursa olsun bebeklerinıze anlamlı ve kültürel bir bağ taşıyan bir isim vermek isteyen ebeveynlere küresel standartlarda, tarafsız ve bilimsel bir rehberlik yapmaktır.","about_feedback_title":"Katkı ve Geri Bildirim","about_feedback_p":"Etimoloji ve dil çalışmaları sürekli gelişen bir alandır. Arşivimize yeni isimler önermek veya mevcut isimlerin anlamlarına katkı sağlamak isterseniz, İletişim sayfamız üzerinden ya da doğrudan mail ile bizimle her zaman irtibat kurabilirsiniz.","contact_email_label":"E-posta:","privacy_title":"Gizlilik Politikası","privacy_seo_desc":"KurdishName gizlilik ilkeleri: Veri toplama, çerez kullanımı ve kişisel veri güvenliği hakkında bilgi.","privacy_h1":"Veri Toplama","privacy_p1":"Kullanıcı gizliliği, KurdishName için en yüksek önceliktir. Platformumuz, kullanıcıların isim arama geçmişlerini veya kişisel tercihlerini kesinlikle kimlik belirleyici bir şekilde saklamaz.","privacy_h2":"Çerezler (Cookies)","privacy_p2":"Kullanıcı deneyimini artırmak ve web trafik analizleri gerçekleştirmek amacıyla standart çerezler kullanılabilir. Bu çerezler üzerinden toplanan tüm veriler tamamen anonimdir.","privacy_h3":"Üçüncü Şahıslar","privacy_p3":"Sitemizde toplanan hiçbir anonim analitik veri, ticari ya da reklam odaklı amaçlarla üçüncü şahıslarla veya kurumlarla paylaşılmaz.","privacy_h4":"Güvenlik","privacy_p4":"Web sitemiz SSL şifreleme sertifikası ile korunmakta olup, her türlü kullanım deneyiminiz KurdishName güvencesi altındadır.","privacy_h5":"İletişim","privacy_p5":"Gizlilik ilkelerimiz ve veri güvenliğiniz ile ilgili tüm sorularınız için info@kurdishname.com adresi üzerinden bizimle her zaman iletişime geçebilirsiniz.","terms_title":"Kullanım Koşulları","terms_seo_desc":"KurdishName kullanım koşulları: Hizmet şartları, telif hakları ve sorumluluk reddi beyanı.","terms_h1":"Hizmet Şartları ve Kabul","terms_p1":"KurdishName platformuna erişim sağlayarak ve kullanarak, bu kullanım koşullarını peşinen kabul etmiş sayılırsınız. Bu koşulları onaylamıyorsanız lütfen sitemizi kullanmayınız.","terms_h2":"Telif Hakkı ve Fikri Mülkiyet","terms_p2":"Sitede yer alan isim listeleri, blog yazıları, özgün tasarımlar ve içeriklerin tüm fikri mülkiyet hakları KurdishName'e aittir. İçeriklerin izinsiz kopyalanması, çoğaltılması veya ticari amaçla kullanımı kesinlikle yasaktır.","terms_h3":"Önemli Uyarı ve Sorumluluk Reddi","terms_p3":"KurdishName platformunda sunulan isim anlamları, kökenleri ve kültürel analizler yalnızca bilgilendirme amaçlıdır.\n\n1. Doğruluk Garantisi: Verilerimiz titizlikle incelenmiş olsa da, bilgilerin %100 doğruluğu, eksiksizliği veya güncelliği konusunda hiçbir garanti verilmemektedir.\n\n2. Kişisel Kararlar: Bebeğinize isim seçme veya resmi evraklarda bu bilgileri kullanma kararı tamamen kullanıcının kendi sorumluluğundadır.\n\n3. Hukuki Muafiyet: İsimlerin anlamlarından, kökenlerinden veya telaffuzlarından kaynaklanabilecek maddi, manevi veya hukuki hiçbir ihtilafta KurdishName platformu sorumlu tutulamaz. Sitemizi kullanarak bu şartları peşinen kabul etmiş sayılırsınız.","terms_h4":"Değişiklik Hakkı","terms_p4":"KurdishName, önceden herhangi bir bildirimde bulunmaksızın bu kullanım koşullarını dilediği an güncelleme, değiştirme veya yenileme hakkını saklı tutar.","cookies_title":"Çerez Politikası","cookies_seo_desc":"KurdishName çerez politikası, çerez kullanımı ve tercih yönetimi bilgilendirmesi.","cookies_h1":"Çerez (Cookie) Nedir?","cookies_p1":"Çerezler, ziyaret ettiğiniz web siteleri tarafından bilgisayarınıza veya mobil cihazınıza kaydedilen küçük metin dosyalarıdır. Sitelerin verimli çalışmasını sağlar ve kullanıcı deneyimini iyileştirir.","cookies_h2":"Çerezleri Nasıl Kullanıyoruz?","cookies_p2":"KurdishName, istatistiksel analizler yapmak, trafik oranlarını izlemek ve site içi dil tercihlerinizi (TR, EN vb.) hatırlamak temel amaçlarıyla anonim analitik çerezler ve işlevsel çerezler kullanmaktadır. Kesinlikle reklam amaçlı izinsiz çerez kullanımı yapılmamaktadır.","cookies_h3":"Çerezleri Yönetme","cookies_p3":"Tarayıcı ayarlarınızı değiştirerek çerezleri dilediğiniz gibi kontrol edebilir, silebilir veya engellenmesini sağlayabilirsiniz. Daha fazla bilgi için tarayıcınızın 'Yardım' menüsüne başvurabilirsiniz.","contact_title":"İletişim","contact_seo_desc":"KurdishName ile iletişime geçin. Görüş, öneri ve şikayetleriniz için bize ulaşın.","contact_desc":"Görüş, öneri veya şikayetleriniz için aşağıdaki formu kullanabilir ya da e-posta ile bize doğrudan ulaşabilirsiniz.","contact_name":"İsim Soyisim","contact_name_ph":"Adınızı soyadınızı giriniz","contact_email":"E-posta Adresiniz","contact_email_ph":"E-posta adresinizi giriniz","contact_msg":"Mesajınız","contact_msg_ph":"Bizimle paylaşmak istediklerinizi buraya yazın...","contact_submit":"Mesajı Gönder","contact_success":"Mesajınız başarıyla iletildi. En kısa sürede size geri dönüş yapacağız.","total_names":"TOPLAM İSİM","boy_names":"KÜRTÇE ERKEK İSİMLERİ","girl_names":"KÜRTÇE KIZ İSİMLERİ","home_description":"Kurmanci ve diğer Kürt lehçelerinden türetilmiş 10.000+ isimden oluşan bir koleksiyon. Anlamları, kökenleri ve cinsiyet bilgileriyle birlikte.","name_description_template":"{name} Kürtçe ismi ne anlama gelir? {name} kökeni nedir ve {gender} ismi olarak nasıl telaffuz edilir? Anlamı: {meaning}. Detaylı analizi için tıklayın!","tags":"Etiketler","alphabetical_index":"Kürtçe Alfabetik Dizin","contents":"İçindekiler","origin_Kürtçe_Farsça":"Kürtçe, Farsça","origin_Kürtçe_Arapça":"Kürtçe, Arapça","origin_Farsça_Kürtçe":"Farsça, Kürtçe","origin_İbranice_Arapça":"İbranice, Arapça","not_found_title":"404 - Sayfa Bulunamadı","not_found_heading":"Aradığınız sayfa tozlu raflarda kaybolmuş olabilir.","not_found_text":"Sayfa taşınmış, silinmiş veya hiç var olmamış olabilir. Ana sayfaya dönerek yeni isimler keşfetmeye devam edebilirsiniz.","home_latest_blog":"En Yeni Rehberler & Blog Yazıları","home_latest_blog_desc":"Kürt kültürü, dil etimolojisi ve isim seçimi hakkında en son paylaştığımız uzman yazıları ve rehberleri.","home_view_all_blog":"Tüm Yazıları Gör","home_read_more":"Devamını Oku","blog4_content":"$26","nav_favorites":"İsim Defterim","favorites_title":"İsim Defterim","favorites_subtitle":"Özel Seçim Defteriniz","favorites_seo_desc":"Beğendiğiniz Kürtçe isimleri sakladığınız size özel isim seçim defteri. Kendiniz veya sevdikleriniz için favori Kürtçe isimler listesi.","favorites_empty":"Defteriniz henüz boş. İsimlerin yanındaki kalp (♥) butonuna tıklayarak beğendiğiniz isimleri buraya kaydedebilir, kendi özel listenizi oluşturabilirsiniz!","favorites_clear_all":"Tümünü Temizle","favorites_add":"Deftere Ekle","favorites_remove":"Defterden Çıkar","favorites_count":"Defterinizde {count} isim kayıtlı.","favorites_count_plural":"Defterinizde {count} isim kayıtlı.","whatsapp_share_btn":"WhatsApp'ta Eşine/Ailene Gönder","whatsapp_share_msg":"{name} ismini beğendim! Anlamı: {meaning}. Sence nasıl?","download_card_btn":"İsim Kartını İndir (Instagram / WhatsApp)","seo_link_girls_names":"kürtçe kız isimleri","seo_link_boys_names":"kürtçe erkek isimleri","seo_link_baby_names":"kürtçe bebek isimleri","seo_link_name_finder":"kürtçe isim bulucu","name_breadcrumb_suffix":"Kürtçe İsmi","blog_silo_prefix":"Tüm anlamları, kökenleri ve etimoloji indeksini kapsamlı ","blog_silo_suffix":" rehberimizde keşfedin. Karşılaştırma modülleri ve gelişmiş isim bulucu araçları entegre edilmiştir.","name_silo_prefix":"Bebeğiniz için anlamlı bir ad arıyorsanız, daha fazla ","name_silo_suffix":" rehberimizi keşfedin, köken ve telaffuz analizlerini yan yana karşılaştırın."},"now":"$undefined","timeZone":"Europe/Istanbul","children":"$L27"}]
