da:["$","h2","h2-0",{"children":"İsim Kökenleri"}]
db:["$","p","p-1",{"children":"Modern ve popüler Kürtçe bebek isimleri, kadim köklerin çağdaş dil estetiğiyle harmanlanmasından doğar. Bu isimlerin kökeni genellikle klasik Kürtçedeki doğa betimlemelerine, duygusal kavramlara ve sanatsal ifadelere dayanır. Ancak yeni nesil isimlerin en belirgin özelliği, fonetik olarak kısa, akıcı ve uluslararası düzeyde kolay telaffuz edilebilir olmalarıdır. Dilin tarihsel gelişim süreci içerisinde, ağır fonetik yapılar sadeleşerek modern dünya dillerine uyum sağlayan ve aynı zamanda kültürel anlam derinliğini koruyan yepyeni bir isim hazinesi oluşturmuştur."}]
dc:["$","h2","h2-1",{"children":"Kültürel Önem"}]
dd:["$","p","p-2",{"children":["Günümüzde bebek isimleri seçilirken kültürel kimliği koruma ve küreselleşen dünyaya uyum sağlama kaygısı bir arada yaşanmaktadır. Popüler Kürtçe isimler, ebeveynlerin çocuklarına hem asil bir miras bırakmalarını hem de onların modern toplumda rahatça kendilerini ifade edebilmelerini sağlar. '",["$","a","a-0",{"href":"/tr/isim/arin","children":"Arîn"}],"' veya '",["$","a","a-1",{"href":"/tr/isim/renas","children":"Rênas"}],"' gibi modern tınılı popüler isimler, hem taşıdıkları derin felsefi anlamlar hem de kulağa hoş gelen yapıları nedeniyle son derece büyük ilgi görmektedir. Bu isimler, kültürel sürekliliğin en estetik köprüleridir."]}]
de:["$","h2","h2-2",{"children":"Sık Sorulan Sorular (FAQ)"}]
df:["$","h3","h3-100",{"children":"Klasik ve geleneksel Kürtçe isimlerin kaynağı nedir?"}]
e0:["$","p","p-3",{"children":"Bu isimler genellikle Kürt tarihindeki meşhur emirliklerden (Mervaniler, Erdelan, Behdinan), köklü aşiret yapılarından, halk destanlarından ve klasik Kürt edebiyatından (Feqîyê Teyran, Ahmedi Xani) gelir."}]
e1:["$","h3","h3-101",{"children":"Kürtçe klasik erkek isimlerine örnekler nelerdir?"}]
e2:["$","p","p-4",{"children":[["$","a","a-0",{"href":"/tr/isim/baban","children":"Baban"}]," (emirilik), ",["$","a","a-1",{"href":"/tr/isim/deysem","children":"Deysem"}]," (tarihi lider), ",["$","a","a-2",{"href":"/tr/isim/keyhusrev","children":"Keyhusrev"}]," (hükümdar), ",["$","a","a-3",{"href":"/tr/isim/mirxan","children":"Mîrxan"}]," (beylerin hanı) ve Pêşewa (önder) gibi isimler öne çıkan ağır ve asil klasik isimlerdendir."]}]
