5:["$","$Ldd",null,{"formats":"$undefined","locale":"de","messages":{"brand_names":"KurdishName","seo_home_title":"Kurdische Namen Bedeutung & Kultur-Enzyklopädie (10.000+ Namen)","seo_home_description":"Entdecken Sie das weltweit umfassendste Archiv mit über 10.000 kurdischen Namen. Finden Sie detaillierte Bedeutungen, Herkunft, Etymologie und Namensratgeber.","site_title":"KurdishName | En Kapsamlı Kürtçe İsimler Arşivi","nav_home":"Startseite","nav_girls":"Kurdische Mädchennamen","nav_boys":"Kurdische Jungennamen","nav_blog":"Blog","nav_finder":"Kurdischer Namensfinder","featured_girl_name":"Kurdischer Mädchenname des Tages","featured_boy_name":"Kurdischer Jungenname des Tages","origin_Kürtçe":"Kurdisch","origin_Farsça":"Persisch","origin_Arapça":"Arabisch","origin_İbranice":"Hebräisch","origin_Sanskritçe":"Sanskrit","origin_Latince":"Lateinisch","origin_Yunanca":"Griechisch","search_results_title_tag":"\"{q}\" Suchergebnisse – KurdishName","search_results_header":"Suche: \"{q}\"","names_found_count":"Namen gefunden.","back_to_home":"Zurück zur Startseite","search_no_results":"Keine Ergebnisse gefunden.","search_try_again_hint":"Bitte versuchen Sie es mit einem anderen Wort erneut.","theme_toggle":"Dunkelmodus","loading_new_names":"Neue Namen werden geladen...","letter_no_results":"Keine Namen für diesen Buchstaben gefunden.","search_btn_text":"Suchen","random_name_discover_title":"Zufälligen Namen entdecken","popular_searches":"Beliebt:","aria_alphabet_letter_label":"Namen, die mit dem Buchstaben {letter} beginnen","aria_view_girls_label":"Mädchennamen ansehen","aria_view_boys_label":"Jungennamen ansehen","share_btn":"Link kopieren","similar_names":"Ähnliche Namen","random":"Zufällig","origin_Kurdish_Crossover":"Kurdisch (Crossover)","home_title":"Kurdisches Namensarchiv","home_h1_title":"Das umfassendste kurdische Namensarchiv","home_desc":"Entdecken Sie kurdische Jungen- und Mädchennamen zusammen mit ihren Bedeutungen, Ursprüngen und passenden Namensvorschlägen.","home_badge":"2026 Moderne Kurdische Namen","home_total":"Gesamt","home_female":"Mädchen","home_male":"Jungen","home_btn_boys":"Kurdische Jungennamen","home_btn_finder":"Kurdischer Namensfinder","home_random_girls":"Zufällige kurdische Mädchennamen","home_random_boys":"Zufällige kurdische Jungennamen","home_categories":"Kurdische Namenskategorien","footer_copy":"© 2026 KurdishName - kurdishname.com","footer_privacy":"Datenschutzerklärung","footer_terms":"Nutzungsbedingungen","footer_cookies":"Cookie-Richtlinie","footer_contact":"Kontakt","footer_about":"Über uns","sidebar_boys":"Kurdische Jungennamen","sidebar_girls":"Kurdische Mädchennamen","sidebar_letters":"Kurdische Namen nach Buchstaben","sidebar_view_all":"Alle ansehen ({gender})","cat_title_kiz":"Kurdische Mädchennamen","cat_title_erkek":"Kurdische Jungennamen","cat_title_letter":"Kurdische Namen, die mit {letter} beginnen","cat_desc_kiz":"Entdecken Sie die schönsten, modernsten und bedeutungsvollsten kurdischen Mädchennamen. Herkunft, tiefe Bedeutung und Aussprachehilfe!","cat_desc_erkek":"Traditionelle, kraftvolle und moderne kurdische Jungennamen. Finden Sie den perfekten Namen mit ausführlicher Herkunfts- und Bedeutungsanalyse!","category_girls_title":"Kurdische Mädchennamen","category_boys_title":"Kurdische Jungennamen","category_girls_description":"Entdecken Sie die schönsten, modernsten und bedeutungsvollsten kurdischen Mädchennamen. Herkunft, tiefe Bedeutung und Aussprachehilfe!","category_boys_description":"Traditionelle, kraftvolle und moderne kurdische Jungennamen. Finden Sie den perfekten Namen mit ausführlicher Herkunfts- und Bedeutungsanalyse!","cat_intro_kiz":"Eine kuratierte Sammlung schöner, bedeutungsvoller und beliebter kurdischer Mädchennamen.","cat_intro_erkek":"Eine kuratierte Sammlung starker, edler und traditioneller kurdischer Jungennamen.","cat_desc_letter":"Alle kurdischen Namen, die mit dem Buchstaben {letter} beginnen. Erfahren Sie Herkunft, etymologische Wurzeln und Aussprache!","detail_meaning":"Bedeutung","detail_origin":"Herkunft","detail_gender":"Geschlecht","detail_letter":"Buchstabe","detail_related":"Ähnliche Namen","detail_view_all":"Alle {gender} Namen ansehen","finder_title":"Kurdischer Namensfinder","finder_seo_desc":"Intelligentes Filtertool zum Finden kurdischer Namen. Suchen Sie Babynamen nach Geschlecht, Thema und Anfangsbuchstabe.","finder_step1":"Schritt 1: Geschlecht","finder_step2":"Schritt 2: Thema (Optional)","finder_step3":"Schritt 3: Buchstabe (Optional)","finder_back":"Zurück","finder_finish":"Namen ansehen ({count})","finder_empty":"Keine Namen gemäß Ihren Kriterien gefunden. Bitte lockern Sie Ihre Filter.","finder_result_title":"Für Sie ausgewählte Namen","finder_try_again":"Von vorn anfangen","finder_diff_matter":"Egal","blog_title":"Blog","blog_read_more":"Weiterlesen","blog1_title":"Kurdische Mädchennamen und deren Bedeutungen","blog1_desc":"Entdecken Sie die schönsten kurdischen Namen.","blog1_content":"Kurdische Kultur bietet sehr poetische Namen für Mädchen. ...","blog2_title":"Kurdische Jungennamen und deren Bedeutungen","blog2_desc":"Beliebte und edle Jungennamen.","blog2_content":"Viele traditionelle und machtvolle Namen für Jungen. ...","blog3_title":"Die schönsten kurdischen Namen für Mädchen","blog3_desc":"Tolle Namensvorschläge für werdende Eltern.","blog3_content":"Sind Sie auf der Suche nach einem schönen Mädchennamen? ...","admin_login_title":"Admin-Bereich","admin_login_desc":"Melden Sie sich beim Kontrollfeld an","admin_username":"Benutzername","admin_password":"Passwort","admin_login_btn":"Anmelden","admin_invalid_creds":"Ungültiger Benutzername oder Passwort","admin_menu_dashboard":"Dashboard","admin_menu_names":"Namensliste","admin_menu_settings":"Seiten-Einstellungen","admin_menu_logout":"Abmelden","admin_menu_goto_site":"Zur Website gehen","admin_dash_title":"Dashboard-Zusammenfassung","admin_dash_total":"Gesamte Namen","admin_dash_girls":"Mädchennamen","admin_dash_boys":"Jungennamen","ad