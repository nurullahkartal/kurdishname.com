19b:["$","tr","stran",{"children":[["$","td",null,{"style":{"fontWeight":700,"whiteSpace":"nowrap"},"children":["$","$L4",null,{"href":"/de/name/stran","style":{"color":"var(--female)"},"children":"Stran"}]}],["$","td",null,{"style":{"whiteSpace":"nowrap"},"children":["$","span",null,{"className":"badge-female","children":"Mädchen"}]}],["$","td",null,{"children":"Stran; eine Persönlichkeit, die die Bedeutung von Lied, Volkslied, Melodie; Ein Mensch, der das Leben wie ein Kunstwerk lebt und dessen Seele voller Musik ist und eine edle Haltung in den Mittelpunkt des Lebens stellt und eine tief verwurzelte Geschichte und ein edles Erbe repräsentiert."}]]}]
