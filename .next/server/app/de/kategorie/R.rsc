296:["$","tr","ruxsar",{"children":[["$","td",null,{"style":{"fontWeight":700,"whiteSpace":"nowrap"},"children":["$","$L4",null,{"href":"/de/name/ruxsar","style":{"color":"var(--female)"},"children":"Ruxsar"}]}],["$","td",null,{"style":{"whiteSpace":"nowrap"},"children":["$","span",null,{"className":"badge-female","children":"Mädchen"}]}],["$","td",null,{"children":"Ruxsar; eine ganz besondere und kostbare Persönlichkeit, die Liebe und Schönheit mit einem Herzen voller Gesicht, Gesichtsausdruck; Sie ist eine Frau, die durch ihre Schönheit auffällt und eine edle Haltung einnimmt., edler Haltung und Eleganz ausstrahlt."}]]}]
