290:["$","tr","rupak",{"children":[["$","td",null,{"style":{"fontWeight":700,"whiteSpace":"nowrap"},"children":["$","$L4",null,{"href":"/de/name/rupak","style":{"color":"var(--female)"},"children":"Rûpak"}]}],["$","td",null,{"style":{"whiteSpace":"nowrap"},"children":["$","span",null,{"className":"badge-female","children":"Mädchen"}]}],["$","td",null,{"children":"Rûpak; eine Persönlichkeit, die die Bedeutung von Er ist ein Mensch, der mit seinem reinen Gesicht, seiner Sündenlosigkeit und seiner moralischen Reinheit ein Vorbild für die Gesellschaft ist. und eine edle Haltung in den Mittelpunkt des Lebens stellt und eine tief verwurzelte Geschichte und ein edles Erbe repräsentiert."}]]}]
291:["$","tr","rusa",{"children":[["$","td",null,{"style":{"fontWeight":700,"whiteSpace":"nowrap"},"children":["$","$L4",null,{"href":"/de/name/rusa","style":{"color":"var(--female)"},"children":"Rûşa"}]}],["$","td",null,{"style":{"whiteSpace":"nowrap"},"children":["$","span",null,{"className":"badge-female","children":"Mädchen"}]}],["$","td",null,{"children":"Rûşa; ein edler Hauch der Hoffnung, der Er ist jemand, der ein fröhliches Gesicht hat, das Leben liebt und die Menschen um ihn herum mit seiner Fröhlichkeit beeindruckt. bringt und jedem Herzen Freude, Frieden und einen Neuanfang verspricht."}]]}]
292:["$","tr","ruse",{"children":[["$","td",null,{"style":{"fontWeight":700,"whiteSpace":"nowrap"},"children":["$","$L4",null,{"href":"/de/name/ruse","style":{"color":"var(--female)"},"children":"Ruşe"}]}],["$","td",null,{"style":{"whiteSpace":"nowrap"},"children":["$","span",null,{"className":"badge-female","children":"Mädchen"}]}],["$","td",null,{"children":"Ruşe; rein, frisch und lebendig wie sonniges Gesicht; Er ist ein edler und eleganter Mensch, der mit seinem Gesicht die Dunkelheit erhellt.; eine edle Persönlichkeit, die das reinste und anmutigste Flüstern der Natur verkörpert."}]]}]
