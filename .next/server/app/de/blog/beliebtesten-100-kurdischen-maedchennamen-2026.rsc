5:["$","$L3b",null,{"formats":"$undefined","locale":"de","messages":{"brand_names":"KurdishName","seo_home_title":"Kurdische Namen Bedeutung & Kultur-Enzyklopädie (10.000+ Namen)","seo_home_description":"Entdecken Sie das weltweit umfassendste Archiv mit über 10.000 kurdischen Namen. Finden Sie detaillierte Bedeutungen, Herkunft, Etymologie und Namensratgeber.","site_title":"KurdishName | En Kapsamlı Kürtçe İsimler Arşivi","nav_home":"Startseite","nav_girls":"Kurdische Mädchennamen","nav_boys":"Kurdische Jungennamen","nav_blog":"Blog","nav_finder":"Kurdischer Namensfinder","featured_girl_name":"Kurdischer Mädchenname des Tages","featured_boy_name":"Kurdischer Jungenname des Tages","origin_Kürtçe":"Kurdisch","origin_Farsça":"Persisch","origin_Arapça":"Arabisch","origin_İbranice":"Hebräisch","origin_Sanskritçe":"Sanskrit","origin_Latince":"Lateinisch","origin_Yunanca":"Griechisch","search_results_title_tag":"\"{q}\" Suchergebnisse – KurdishName","search_results_header":"Suche: \"{q}\"","names_found_count":"Namen gefunden.","back_to_home":"Zurück zur Startseite","search_no_results":"Keine Ergebnisse gefunden.","search_try_again_hint":"Bitte versuchen Sie es mit einem anderen Wort erneut.","theme_toggle":"Dunkelmodus","loading_new_names":"Neue Namen werden geladen...","letter_no_results":"Keine Namen für diesen Buchstaben gefunden.","search_btn_text":"Suchen","random_name_discover_title":"Zufälligen Namen entdecken","popular_searches":"Beliebt:","aria_alphabet_letter_label":"Namen, die mit dem Buchstaben {letter} beginnen","aria_view_girls_label":"Mädchennamen ansehen","aria_view_boys_label":"Jungennamen ansehen","share_btn":"Link kopieren","similar_names":"Ähnliche Namen","random":"Zufällig","origin_Kurdish_Crossover":"Kurdisch (Crossover)","home_title":"Kurdisches Namensarchiv","home_h1_title":"Das umfassendste kurdische Namensarchiv","home_desc":"Entdecken Sie kurdische Jungen- und Mädchennamen zusammen mit ihren Bedeutungen, Ursprüngen und passenden Namensvorschläge