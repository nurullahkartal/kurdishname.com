5:["$","$L76",null,{"formats":"$undefined","locale":"ar","messages":{"brand_names":"KurdishName","seo_home_title":"معاني الأسماء الكردية وموسوعة الثقافة (أكثر من 10,000 اسم)","seo_home_description":"اكتشف الأرشيف الأكثر شمولاً لأكثر من 10,000 اسم كردي. استكشف المعاني الدقيقة، الأصول التاريخية، علم الاشتقاق، وأدلة أسماء المواليد الحديثة.","site_title":"KurdishName | En Kapsamlı Kürtçe İsimler Arşivi","nav_home":"الرئيسية","nav_girls":"أسماء بنات كردية","nav_boys":"أسماء أولاد كردية","nav_blog":"المدونة","nav_finder":"مكتشف الأسماء الكردية","featured_girl_name":"اسم بنت كردية اليوم","featured_boy_name":"اسم ولد كردي اليوم","origin_Kürtçe":"كردي","origin_Farsça":"فارسي","origin_Arapça":"عربي","origin_İbranice":"عبري","origin_Sanskritçe":"سنسكريتي","origin_Latince":"لاتيني","origin_Yunanca":"يوناني","search_results_title_tag":"\"{q}\" نتائج البحث – KurdishName","search_results_header":"بحث: \"{q}\"","names_found_count":"أسماء تم العثور عليها.","back_to_home":"العودة إلى الصفحة الرئيسية","search_no_results":"لم يتم العثور على نتائج.","search_try_again_hint":"يرجى المحاولة مرة أخرى بكلمة مختلفة.","theme_toggle":"الوضع الليلي","loading_new_names":"جاري تحميل أسماء جديدة...","letter_no_results":"لم يتم العثور على أسماء تطابق المعايير لهذا الحرف.","search_btn_text":"بحث","random_name_discover_title":"اكتشف اسم عشوائي","popular_searches":"شائع:","aria_alphabet_letter_label":"الأسماء التي تبدأ بحرف {letter}","aria_view_girls_label":"رؤية أسماء البنات","aria_view_boys_label":"رؤية أسماء الأولاد","share_btn":"نسخ الرابط","similar_names":"أسماء مشابهة","random":"عشوائي","origin_Kurdish_Crossover":"كردي مشترك","home_title":"أرشيف الأسماء الكردية","home_h1_title":"أرشيف الأسماء الكردية الأكثر شمولاً","home_desc":"اكتشف أسماء الأولاد والبنات الكردية مع معانيها وأصولها واقتراحات لأسماء مشابهة.","home_badge":"الأسماء الكردية الحديثة لعام 2026","home_total":"الإجمالي","home_female":"بنات","home_male":"أولاد","home_btn_boys":"أسماء أولاد كردية","home_btn_finder":"مكتشف الأسماء الكردية",