dd:["$","h3","h3-100",{"children":"ما هو أصل الأسماء الكردية الأسطورية والملحمية؟"}]
de:["$","p","p-3",{"children":"تستمد هذه الأسماء أصولها من ميثولوجيا ميزوبوتاميا القديمة، الفلسفة الزرادشتية العريقة، ملحمة مم وزين الخالدة، والإمارات التاريخية الكردية الكبرى."}]
df:["$","h3","h3-101",{"children":"ما هي أشهر أسماء الأبطال الأسطوريين في الثقافة الكردية؟"}]
e0:["$","p","p-4",{"children":"تعد أسماء كاوه (الحداد الأسطوري)، رستم (البطل الخارق)، سيامند (بطل الملحمة العاطفية)، وآزاد (الحر) من أبرز تلك الأسماء الملحمية الشامخة."}]
