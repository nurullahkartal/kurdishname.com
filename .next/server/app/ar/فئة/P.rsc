":"هل أنت متأكد أنك تريد حذف هذا الاسم؟","admin_names_empty":"لا توجد سجلات.","admin_names_limit":"تقتصر القائمة المعروضة على 50 سجلاً. المجموع: {count}","admin_settings_title":"إعدادات الموقع","admin_settings_save":"حفظ الإعدادات","admin_settings_saved":"تم الحفظ","admin_settings_seo_tr":"SEO العام والعنوان (التركية)","admin_settings_seo_en":"SEO العام والعنوان (الإنجليزية)","admin_settings_site_title":"عنوان الموقع","admin_settings_site_desc":"وصف ميتا","admin_settings_sys":"إعدادات النظام","admin_settings_maint":"وضع الصيانة","gender_female":"بنت","gender_male":"ولد","gender_both":"مشترك","gender_unisex":"للجنسين","not_found":"الاسم غير موجود","default_origin":"كردي","no_meaning":"لم يتم إضافة معنى هذا الاسم بعد. ومع ذلك، فإنه يحتل مكانة هامة في التراث الثقافي الكردي.","seo_keywords_names":"معنى اسم {name}، أسماء كردية، أسماء {genderText} كردية","seo_name_title":"ما معنى اسم {name} بالكردية؟ معنى اسم {name} وأصله","detail_meaning_rich":"ما معنى اسم {name}؟ معنى اسم {name} بالتفصيل","detail_origin_rich":"أصل اسم {name} - تاريخ الأسماء الكردية وعلم الاشتقاق","detail_gender_rich":"جنس اسم {name} والتحليل الثقافي له","detail_gender_desc":"يُصنف اسم {name} ضمن أسماء ال{genderText} الكردية الحديثة. يُختار هذا الاسم بشكل أساسي للمواليد من ال{genderText}، ويعتبر اسم {name} أحد الخيارات الأكثر شعبية وأناقة بين أسماء الأطفال الكردية نظراً لمعناه الجميل ونطقه الموسيقي اللطيف.","detail_similar_rich":"أسماء {genderText} كردية حديثة مشابهة لاسم {name}","seo_blog_keywords":"أسماء كردية، أسماء أطفال، مدونة","seo_blog_desc":"المدونة الأكثر شمولاً وأدلة الخبراء حول اختيار الأسماء الكردية والأصول الثقافية وأسماء الأطفال الحديثة وعلم أصول الكلمات اللغوية.","theme_nature":"الطبيعة، شجرة، زهرة","theme_power":"القوة، الشجاعة، البطولة","theme_beauty":"الحب، الجمال، رقيق","theme_light":"الشمس، النور، السطوع","theme_wisdom":"الحكمة، العقل، النجاح","theme_mixed":"مختلط (لا يهم)","cat_all_themes":"جميع المواضيع","search_placeholder":"البحث بين أكثر من 10.000 اسمًا...","trends_title":"اتجاهات الأسبوع والأسماء الشائعة","trends_desc":"الأسماء الكردية الأكثر تفضيلاً وبحثاً خلال هذا الأسبوع للأطفال.","trends_live":"مباشر","suggest":"اقتراح-اسم","suggest_badge":"موسع الأرشيف","suggest_title":"اقتراح اسم جديد","suggest_seo_title":"اقتراح اسم كردي جديد","suggest_seo_desc":"شاركنا بالأسماء الكردية التي لم تدرج بعد في قاعدة بياناتنا مع معانيها وجنسها، لنعمل معاً على توسيع الأرشيف الكردي الشامل.","suggest_desc":"شاركنا بالأسماء الكردية التي لم تدرج بعد في قاعدة بياناتنا. سنقوم بإضافتها في أقرب وقت ممكن بعد التحقق الأكاديمي.","suggest_label_name":"الاسم المقترح","suggest_placeholder_name":"مثل: Arîn، Alend...","suggest_label_gender":"الجنس","suggest_label_meaning":"المعنى والملاحظات","suggest_placeholder_meaning":"المعنى المعروف للاسم، كتاب مرجعي، أو أصل تاريخي...","suggest_label_email":"عنوان بريدك الإلكتروني (اختياري)","suggest_opt_in":"أبلغني عند إضافة هذا الاسم ونشر تحديثات جديدة.","suggest_btn_submit":"إرسال الاقتراح","suggest_success_title":"تم استلام اقتراحك!","suggest_success_desc":"سنقوم بتحليل الاسم المقترح أكاديمياً وإضافته إلى أرشيفنا بمجرد التحقق منه. شكرًا لك على إبقاء تراث التسمية الكردية حيًا!","suggest_another":"اقتراح اسم آخر","compare":"مقارنة","nav_compare":"مقارنة","compare_seo_title":"أداة مقارنة الأسماء الكردية","compare_seo_desc":"قارن بين أسماء الأطفال الكردية المفضلة لديك جنباً إلى جنب من حيث المعنى والأصل والشعبية والانسجام الصوتي لاتخاذ القرار الأفضل.","compare_badge":"محرك دعم اتخاذ القرار","compare_title":"وحدة مقارنة الأسماء","compare_desc":"متردد؟ ضع الاسمين الكرديين المفضلين لديك جنباً إلى جنب؛ وقارن بين المعاني، والأجناس، وأطوال الحروف، والانسجام الصوتي لاتخاذ الخيار الأمثل!","compare_label_1":"الاسم الأول","compare_label_2":"الاسم الثاني","compare_placeholder":"ابحث عن اسم للمقارنة...","compare_harmony_score":"مؤشر الانسجام الصوتي","compare_harmony_desc":"معامل التشابه الصوتي ومحاذاة بنية الحروف.","compare_stat_length":"عدد الحروف","compare_stat_meaning":"المعنى","compare_stat_origin":"الأصل","compare_stat_gender":"الجنس","compare_stat_popularity":"مستوى الاتجاه","compare_quick_fav":"اختيار سريع من المفضلة:","compare_empty_title":"لم يتم اختيار اسم","compare_empty_desc":"ابحث عن اسمين في المربعات أعلاه، أو انقر على الأسماء المفضلة لديك لبدء مقارنتها جنباً إلى جنب!","harmony_good":"انسجام جيد","harmony_perfect":"انسجام تام!","harmony_neutral":"بنية متوافقة","select_first_name":"يرجى تحديد الاسم الأول","select_second_name":"يرجى تحديد الاسم الثاني","clear_comparison":"مسح المقارنة","favorites_compare_cta_title":"قارن بين الأسماء المفضلة لديك","favorites_compare_cta_desc":"ضع أسماء الأطفال المحفوظة لديك جنباً إلى جنب لمراجعة معانيها وانسجامها الصوتي.","favorites_compare_cta_btn":"قارن الآن","search_suggest_cta_title":"ألم تجد الاسم الذي تبحث عنه؟","search_suggest_cta_desc":"قد لا يكون الاسم الكردي الذي بحثت عنه في قاعدة بياناتنا بعد. اقترحه الآن، وسنضيفه بعد التحقق الأكاديمي!","cat_theme_nature":"الطبيعة / الحياة","cat_theme_power":"شجاعة / قوة","cat_theme_beauty":"حب / جمال","aria_search_label":"البحث عن الأسماء","aria_search_button":"بحث","aria_lang_switch":"التبديل إلى {lang}","aria_nav_label":"التنقل في الموقع","cat_theme_light":"نور / سطوع","cat_theme_wisdom":"حكمة / عقل","theme_nature_title":"أسماء الطبيعة الكردية","theme_nature_desc":"أجمل أسماء المواليد الكردية ومعانيها المستوحاة من الطبيعة والأشجار والزهور وحيوية الحياة.","theme_power_title":"أسماء القوة والشجاعة الكردية","theme_power_desc":"أنبل الأسماء الكردية التي تمثل القوة والشجاعة والبسالة والبطولة والنبل.","theme_beauty_title":"أسماء الحب والجمال الكردية","theme_beauty_desc":"أشهر الأسماء الكردية التي تحمل معاني الحب والجمال والأناقة والنعومة والرقة.","theme_light_title":"أسماء النور والسطوع الكردية","theme_light_desc":"أسماء أطفال كردية ذات مغزى تشع بالشمس والنور والنجوم والسطوع والفجر والضياء.","theme_wisdom_title":"أسماء الحكمة والفكر الكردية","theme_wisdom_desc":"قائمة بالأسماء الكردية التي تمثل الحكمة والعقل والذكاء والنبل والرؤية والنجاح.","theme_nature_intro":"تُمثّل الأسماء الكردية ذات الطابع الطبيعي إحدى أعرق تقاليد التسمية في الذاكرة الثقافية لبلاد ما بين النهرين الممتدة لآلاف السنين. هذه الأسماء التي تختزل في لفظة واحدة هيبة الجبال ووضوح الأنهار وانطلاقة الربيع، تعكس روح الثقافة الكردية من خلال جمالها الصوتي واستعاراتها الطبيعية العميقة. في اللغة الكردية، حمل اسم شجرة أو زهرة أو جدول جبلي لا يعني مجرد هوية، بل هو فلسفة حياة ورابط ثقافي عميق يتوارثه الأبناء عن الآباء جيلاً بعد جيل.","theme_power_intro":"إن الأسماء الكردية ذات موضوع القوة والشجاعة هي رموز ثقافة ملحمية نُسجت من أعماق التاريخ، ومن أناشيد الفروسية التي ترددت في جبال بلاد ما بين النهرين الوعرة، ومن فهم راسخ للشخصية القويمة. لا تحمل هذه الأسماء القوة وحدها، بل تنطوي أيضاً على الشرف والعدل والنبل في أعماقها. لقد شكّلت الأساطير الكردية والملاحم البطولية جذور هذه الأسماء القوية؛ إذ رمى كل اسم إلى نقل روح بطل وتقليد مقاومة شعب عبر الأجيال المتعاقبة.","theme_beauty_intro":"وُلدت الأسماء الكردية ذات موضوعات الجمال والحب من أرق صور الشعر الكردي، ومن قصص الحب القديمة في بلاد ما بين النهرين. هذه الأسماء المنسوجة بكلمات كـ'Evîn' (الحب) و'Hêvî' (الأمل) لا تعكس الجمال الجمالي وحده، بل تعكس أيضاً رقياً ودفئاً ينبعان من أعماق الروح. في الثقافة الكردية، تُعدّ الأسماء الممنوحة إحياءً للحب البوابةَ الأولى التي يلج منها الطفل إلى العالم، وأثمنَ هدية يمكن للأسرة أن تقدمها لوليدها.","theme_light_intro":"الأسماء الكردية ذات الطابع النوراني هي هبة فريدة من ثقافة استوحت إلهامها من الشمس وهي تضيء قمم جبال زاغروس، ومن النجوم وهي تتألق فوق سهول بلاد ما بين النهرين. في الأدب الكردي، يمثّل النور الاستعارةَ الكونية للأمل والمعرفة والحرية. وأسماء من قبيل 'Ronahî' (سطوع)، و'Sterk' (نجمة)، و'Rojda' (شروق الشمس) تعني أكثر من مجرد تسمية طفل — إنها أمنية بمستقبل مشرق ومصير منير.","ctx_share_text":"ألقِ نظرة على هذا الموقع!","ctx_share":"شارك الاسم","ctx_copy":"نسخ","ctx_home":"العودة إلى الرئيسية","spelling_arabic":"الأبجدية العربية (السورانية/الكورمانجية)","spelling_latin":"الأبجدية اللاتينية","spelling_cyrillic":"الأبجدية السيريلية","spelling_etymology":"أصل الكلمة والجذور الثقافية","brand_prefix":"Kurdish Names","finder_step_gender":"جنس","finder_step_theme":"سمة","finder_step_letter":"رسالة","finder_step_results":"النتائج","finder_analyzing":"جاري تحليل الأسماء...","finder_intro_title":"هل أنت مستعد للبحث عن اسم؟","finder_intro_desc":"اكتشف الأسماء الكردية ذات المغزى خطوة بخطوة باستخدام خوارزميتنا الذكية.","finder_step":"خطوة","finder_empty_hint":"يمكنك المحاولة مرة أخرى عن طريق تغيير تفاصيل الفلتر.","about_title":"من نحن","about_seo_desc":"تعرف على KurdishName ورسالتنا ورؤيتنا والغرض من وراء أكبر أرشيف شامل للأسماء الكردية في العالم.","about_vision_title":"مهمتنا ورؤيتنا","about_vision_p":"تأسست KurdishName بهدف الحفاظ على الأسماء — أثمن عناصر التراث الثقافي — وتوثيقها ونقلها بشكل صحيح إلى الأجيال القادمة. بوصفنا أشمل مكتبة باللغة الكردية بأربعة لغات في العالم، نتناول الأصل الاشتقاقي والمعنى الثقافي والبنية الصوتية لكل اسم وفق معايير أكاديمية.","about_archive_title":"أرشيف شامل للأسماء","about_archive_p":"تحتوي قاعدة بياناتنا على أكثر من 10٬000 اسم فريد مجمع من لهجات كردية كالكرمانجية والسورانية والزازاكية والكلهورية. نقدم لمستخدمينا الموضوعات القديمة وراء كل اسم — كالطبيعة والحكمة والمحبة والنبل — عبر واجهة حديثة.","about_trans_title":"دليل متعدد اللغات وموثوق","about_trans_p":"توفر KurdishName دعمًا متزامنًا بالكامل بالتركية والإنجليزية والألمانية والعربية. هدفنا تقديم إرشادات علمية ومحايدة وموثوقة وفق معايير عالمية للآباء في جميع أنحاء العالم الذين يرغبون في منح طفلهم اسمًا ذا معنى عميق وصلة ثقافية بالموروث.","about_feedback_title":"المساهمة والملاحظات","about_feedback_p":"علم الأشتقاق والدراسات اللغوية مجال في تطور مستمر. إذا كنت ترغب في اقتراح أسماء جديدة لأرشيفنا أو المساهمة في معاني الأسماء الموجودة، يسعدنا تواصلك معنا في أي وقت عبر صفحة اتصل بنا أو مباشرةً عبر البريد الإلكتروني.","contact_email_label":"البريد الإلكتروني:","not_found_title":"404 - الصفحة غير موجودة","not_found_heading":"ربما ضاعت الصفحة التي تبحث عنها في الرفوف المملوءة بالغبار.","not_found_text":"ربما تم نقل الصفحة أو حذفها أو لم تكن موجودة من قبل. يمكنك العودة إلى الصفحة الرئيسية ومواصلة اكتشاف أسماء جديدة.","privacy_title":"مبادئ الخصوصية","privacy_seo_desc":"مبادئ الخصوصية لـ KurdishName، معايير أمن البيانات، وبيان الخصوصية المعتمد لدينا.","privacy_h1":"جمع البيانات","privacy_p1":"تعتبر خصوصية المستخدمين الأولوية القصوى لـ KurdishName. إن منصتنا لا تقوم إطلاقاً بحفظ سجلات بحث المستخدمين أو تفضيلاتهم الشخصية بأي شكل يعرّف بهويتهم.","privacy_h2":"ملفات تعريف الارتباط (Cookies)","privacy_p2":"قد يتم استخدام ملفات تعريف الارتباط القياسية لتحسين تجربة المستخدم وإجراء تحليلات حركة المرور على الموقع. جميع البيانات التي يتم جمعها من خلال هذه الملفات مجهولة المصدر تمامًا.","privacy_h3":"أطراف ثالثة","privacy_p3":"لا يتم مطلقاً مشاركة أي بيانات تحليلية مجهولة المصدر يتم جمعها على موقعنا مع أي جهات أو مؤسسات خارجية لأغراض تجارية أو إعلانية.","privacy_h4":"الأمان والحماية","privacy_p4":"موقعنا محمي بالكامل بواسطة شهادة تشفير SSL الآمنة، وتخضع كافة تجارب استخدامك للموقع لضمان وحماية KurdishName.","privacy_h5":"اتصل بنا","privacy_p5":"لأية استفسارات تتعلق بمبادئ الخصوصية وأمن بياناتكم، يسعدنا تواصلكم معنا دائماً عبر البريد الإلكتروني info@kurdishname.com.","terms_title":"شروط الاستخدام","terms_seo_desc":"شروط استخدام KurdishName، حقوق النشر، حماية الملكية الفكرية، وإخلاء المسؤولية القانونية.","terms_h1":"شروط الخدمة والقبول","terms_p1":"بموجب وصولك إلى منصة KurdishName واستخدامها، فإنك تعتبر موافقاً مسبقاً على شروط الاستخدام هذه. وإذا كنت لا توافق على هذه الشروط، يرجى عدم استخدام موقعنا.","terms_h2":"حقوق النشر والملكية الفكرية","terms_p2":"تعود كافة حقوق الملكية الفكرية لقوائم الأسماء، تدوينات المدونة، التصاميم المبتكرة والمحتويات المتاحة على الموقع إلى KurdishName. ويُمنع منعاً باتاً نسخ المحتويات أو إعادة إنتاجها أو استخدامها لأغراض تجارية دون إذن مسبق.","terms_h3":"تنبيه هام وإخلاء مسؤولية","terms_p3":"إن معاني الأسماء وأصولها والتحليلات الثقافية المقدمة على منصة KurdishName هي لأغراض إعلامية وتثقيفية فقط.\n\n1. ضمان الدقة: على الرغم من تدقيق ومراجعة بياناتنا بعناية فائقة، إلا أنه لا يمكن تقديم أي ضمان بشأن دقة المعلومات أو اكتمالها أو حداثتها بنسبة 100%.\n\n2. القرارات الشخصية: تقع مسؤولية اختيار اسم لمولودكم الجديد أو استخدام هذه البيانات في المعاملات الرسمية والحكومية على عاتق المستخدم وحده بالكامل.\n\n3. الإعفاء القانوني: لا يمكن تحميل منصة KurdishName المسؤولية عن أي نزاع مادي أو معنوي أو قانوني قد ينشأ عن معاني الأسماء أو أصولها أو طريقة نطقها. ويعتبر استخدامكم للموقع قبولاً صريحاً ومسبقاً لهذه الشروط.","terms_h4":"حق التعديل","terms_p4":"تحتفظ KurdishName بالحق في تحديث شروط الاستخدام هذه أو تعديلها أو تجديدها في أي وقت ودون إشعار مسبق.","cookies_title":"سياسة ملفات تعريف الارتباط","cookies_seo_desc":"سياسة ملفات تعريف الارتباط لـ KurdishName، واستخدام ملفات تعريف الارتباط، وإرشادات إدارة التفضيلات.","cookies_h1":"ما هو ملف تعريف الارتباط؟","cookies_p1":"ملفات تعريف الارتباط هي ملفات نصية صغيرة يتم حفظها على جهاز الكمبيوتر أو الجهاز المحمول الخاص بك بواسطة مواقع الويب التي تزورها. تضمن عمل المواقع بكفاءة وتحسين تجربة المستخدم.","cookies_h2":"كيف نستخدم ملفات تعريف الارتباط؟","cookies_p2":"تستخدم KurdishName ملفات تعريف الارتباط التحليلية المجهولة وملفات تعريف الارتباط الوظيفية بشكل أساسي لإجراء تحليلات إحصائية وتتبع حركة المرور وتذكر تفضيلات اللغة الخاصة بك داخل الموقع (TR، EN، إلخ). لا نستخدم مطلقًا ملفات تعريف الارتباط لأغراض إعلانية غير مصرح بها.","cookies_h3":"إدارة ملفات تعريف الارتباط","cookies_p3":"من خلال تغيير إعدادات المتصفح الخاص بك، يمكنك التحكم في ملفات تعريف الارتباط أو حذفها أو حظرها كما يحلو لك. لمزيد من المعلومات، يرجى الرجوع إلى قائمة 'المساعدة' في متصفحك.","contact_title":"اتصل بنا","contact_seo_desc":"تواصل مع KurdishName لطرح أي أسئلة أو اقتراحات أو ملاحظات أو لتقديم أسماء جديدة.","contact_desc":"يمكنك استخدام النموذج أدناه أو مراسلتنا عبر البريد الإلكتروني مباشرة لتقديم اقتراحاتك أو ملاحظاتك أو شكاواك.","contact_name":"الاسم الكامل","contact_name_ph":"أدخل اسمك الكامل","contact_email":"عنوان البريد الإلكتروني","contact_email_ph":"أدخل عنوان بريدك الإلكتروني","contact_msg":"رسالتك","contact_msg_ph":"اكتب رسالتك هنا...","contact_submit":"إرسال الرسالة","contact_success":"تم إرسال رسالتك بنجاح. سنرد عليك في أقرب وقت ممكن.","total_names":"إجمالي الأسماء","boy_names":"أسماء أولاد كردية","girl_names":"أسماء بنات كردية","home_description":"مجموعة تضم أكثر من 10.000 اسمًا مستمدة من الكرمانجية واللهجات الكردية الأخرى. مع معانيها وأصولها ومعلومات الجنس.","name_description_template":"معنى اسم {name} بالكردية بالتفصيل: ما هو أصل اسم {name}؟ وهل هو اسم {gender}؟ تصفح معنى الاسم وشرحه التاريخي واللغوي وطريقة نطق اسم {name} بالتفصيل عبر دليل الأسماء الكردية الشامل لدينا.","tags":"الوسوم","alphabetical_index":"الفهرس الأبجدي الكردي","contents":"المحتويات","origin_Kürtçe_Farsça":"كردي، فارسي","origin_Kürtçe_Arapça":"كردي، عربي","origin_Farsça_Kürtçe":"فارسي، كردي","origin_İbranice_Arapça":"عبري، عربي","home_latest_blog":"أحدث الأدلة والمقالات","home_latest_blog_desc":"اكتشفوا أدلتنا المتخصصة، وقصصنا الثقافية، ونصائح اختيار الاسم الأمثل لطفلكم.","home_view_all_blog":"عرض جميع المقالات","home_read_more":"اقرأ المزيد","nav_favorites":"دفتر الأسماء","favorites_title":"دفتر أسمائي المفضل","favorites_subtitle":"دفتر اختيارك الخاص","favorites_seo_desc":"دفتر الأسماء الخاص بك لحفظ الأسماء الكردية التي تعجبك. قائمة بالأسماء المفضلة لك أو لأحبائك.","favorites_empty":"دفترك فارغ حاليًا. اضغط على زر القلب (♥) بجانب الأسماء لحفظ الأسماء التي تعجبك وبناء دفترك الخاص!","favorites_clear_all":"مسح الكل","favorites_add":"إضافة إلى الدفتر","favorites_remove":"إزالة من الدفتر","favorites_count":"يوجد {count} اسم محفوظ في دفترك.","favorites_count_plural":"يوجد {count} اسم محفوظ في دفترك.","whatsapp_share_btn":"أرسل إلى الزوج/العائلة عبر واتساب","whatsapp_share_msg":"لقد اطلعت على الاسم {name} في KurdishName. المعنى: {meaning}. ما رأيك؟","download_card_btn":"تحميل بطاقة الاسم (إنستغرام / واتساب)","seo_link_girls_names":"أسماء بنات كردية","seo_link_boys_names":"أسماء أولاد كردية","seo_link_baby_names":"أسماء كردية للأطفال","seo_link_name_finder":"مكتشف الأسماء الكردية","blog4_content":"الأسماء الكردية هي انعكاسات لتاريخ عريق الجذور وحياة متشابكة مع الطبيعة وأدب غني. يميل الآباء المعاصرون إلى اختيار أسماء تعكس هويتهم الثقافية وتتوافق مع الجماليات الحديثة...\n\nاستخدم أداة [Bâvkêrî Nâvê](/ar/finder) للعثور على مزيد من الأسماء.","name_breadcrumb_suffix":"الاسم الكردي","blog_silo_prefix":"اكتشف جميع المعاني والأصول وفهارس علم أصول الكلمات داخل قائمتنا الشاملة لـ ","blog_silo_suffix":". وحدات المقارنة وأدوات البحث المتقدمة متزامنة.","name_silo_prefix":"إذا كنت تبحث عن اسم مميز لمولودك الجديد، فاكتشف المزيد من ","name_silo_suffix":" عبر دليلنا الشامل المخصص للمقارنة وتحليل الأصول اللغوية."},"now":"$undefined","timeZone":"Europe/Istanbul","children":"$L191"}]
