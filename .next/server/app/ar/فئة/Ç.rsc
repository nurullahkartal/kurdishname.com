ep2":"الخطوة ٢: الموضوع (اختياري)","finder_step3":"الخطوة ٣: الحرف (اختياري)","finder_back":"رجوع","finder_finish":"رؤية الأسماء ({count})","finder_empty":"لم يتم العثور على أسماء تطابق معاييرك.","finder_result_title":"الأسماء المختارة لك","finder_try_again":"ابدأ من جديد","finder_diff_matter":"لا يهم","blog_title":"مدونة","blog_read_more":"اقرأ المزيد","blog1_title":"أسماء بنات كردية ومعانيها","blog1_desc":"اكتشف أجمل الأسماء.","blog1_content":"الأسماء في الثقافة الكردية عميقة المعنى...","blog2_title":"أسماء أولاد كردية","blog2_desc":"أبرز الأسماء وأجملها.","blog2_content":"تمثل أسماء الأولاد القوة والشجاعة...","blog3_title":"أجمل أسماء البنات الكردية","blog3_desc":"أفكار رائعة للآباء.","blog3_content":"هل تبحث عن اسم مميز لابنتك؟...","admin_login_title":"لوحة الإدارة","admin_login_desc":"تسجيل الدخول إلى لوحة التحكم","admin_username":"اسم المستخدم","admin_password":"كلمة المرور","admin_login_btn":"تسجيل الدخول","admin_invalid_creds":"اسم المستخدم أو كلمة المرور غير صالحة","admin_menu_dashboard":"لوحة القيادة","admin_menu_names":"قائمة الأسماء","admin_menu_settings":"إعدادات الموقع","admin_menu_logout":"تسجيل الخروج","admin_menu_goto_site":"اذهب للموقع","admin_dash_title":"ملخص لوحة القيادة","admin_dash_total":"إجمالي الأسماء","admin_dash_girls":"أسماء البنات","admin_dash_boys":"أسماء الأولاد","admin_dash_multilang":"دعم متعدد اللغات","admin_dash_lang_dist":"توزيع اللغات","admin_dash_db_ready":"بنية قاعدة البيانات جاهزة","admin_dash_db_desc":"تحاكي القوائم الحالية عمليات CRUD المؤقتة عبر localStorage. بالنسبة للبيئات الحقيقية ، ما عليك سوى توصيل خلفية مثل Firebase أو PostgreSQL.","admin_names_title":"قائمة الأسماء","admin_names_add":"إضافة اسم جديد","admin_names_search":"ابحث عن اسم...","admin_names_all_genders":"كل الأجناس","admin_names_female":"بنت","admin_names_male":"ولد","admin_names_both":"مشترك","admin_names_col_name":"الاسم","admin_names_col_meaning":"المعنى","admin_names_col_gender":"الجنس","admin_names_col_actions":"الإجراءات","admin_names_confirm_delete"