db:["$","p","p-1",{"children":["The origins of Kurdish names containing virtue, spirituality, and artistic content are based on the rich divan poets of classical Kurdish literature (Feqîyê Teyran, Melayê ",["$","a","a-0",{"href":"/en/name/ciziri","children":"Cizîrî"}],"), the deep philosophy of traditional Dengbej songs, and ancient human values. Symbolizing aesthetic concepts such as poetry (Helbest), melody (Lorin, Lullaby), belief, and honesty, these names emerged by selecting and naming the most elegant meanings of words during the literary development process of Kurdish."]}]
dc:["$","h2","h2-1",{"children":"Cultural Significance"}]
dd:["$","p","p-2",{"children":"Names in this category glorify social morality, deep passion for art, and spiritual purification. Families who give these names to their babies desire them to have an aesthetic perspective, high moral values, and artistic sensitivity throughout their lives. While 'Helbest' symbolizes poetic sensitivity, virtue-themed names express the desire to raise an individual who is beneficial to society, wise, and noble. These names both sound extremely elegant and soothe the soul with the meanings they carry."}]
de:["$","h2","h2-2",{"children":"Frequently Asked Questions (FAQ)"}]
df:["$","h3","h3-100",{"children":"What themes do Kurdish literary and artistic names represent?"}]
e0:["$","p","p-3",{"children":"Literary and artistic names generally signify poetry (helbest), traditional music (saz, lori, deng), natural colors, and elegant aesthetics."}]
e1:["$","h3","h3-101",{"children":"What are some highly favored Kurdish artistic names?"}]
e2:["$","p","p-4",{"children":["Names like Helbest (poetry), Lorin (melody, lullaby), ",["$","a","a-0",{"href":"/en/name/zerya","children":"Zerya"}]," (ocean), ",["$","a","a-1",{"href":"/en/name/baran","children":"Baran"}]," (rain), and Dilshad (joyful heart) are highly popular."]}]
e3:["$","section",null,{"style":{"marginTop":"2.5rem","paddingTop":"1.5rem","borderTop":"1px solid var(--border)"},"children":[["$","h2",null,{"className":"section-heading","children":"FAQ"}],["$","div",null,{"style":{"display":"flex","flexDirection":"column","gap":"0.75rem"},"children":[["$","div","0",{"style":{"background":"var(--surface-alt)","border":"1px solid var(--border)","borderRadius":"var(--r-md)","padding":"1rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.95rem","fontWeight":700,"margin":"0 0 0.35rem 0"},"children":"What themes do Kurdish literary and artistic names represent?"}],["$","p",null,{"style":{"fontSize":"0.85rem","color":"var(--text-muted)","margin":0,"lineHeight":1.65},"children":"Literary and artistic names generally signify poetry (helbest), traditional music (saz, lori, deng), natural colors, and elegant aesthetics."}]]}],["$","div","1",{"style":{"background":"var(--surface-alt)","border":"1px solid var(--border)","borderRadius":"var(--r-md)","padding":"1rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.95rem","fontWeight":700,"margin":"0 0 0.35rem 0"},"children":"What are some highly favored Kurdish artistic names?"}],["$","p",null,{"style":{"fontSize":"0.85rem","color":"var(--text-muted)","margin":0,"lineHeight":1.65},"children":"Names like Helbest (poetry), Lorin (melody, lullaby), Zerya (ocean), Baran (rain), and Dilshad (joyful heart) are highly popular."}]]}]]}]]}]
