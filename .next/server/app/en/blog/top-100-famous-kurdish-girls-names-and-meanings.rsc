16:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Flowers and Nature:"}]," The freshest and most elegant elements of nature, such as snowdrop (",["$","a","a-0",{"href":"/en/name/berfin","children":"Berfîn"}],"), mountain flower (",["$","a","a-1",{"href":"/en/name/asmin","children":"Asmîn"}],"), or sesame flower (",["$","a","a-2",{"href":"/en/name/sosin","children":"Sosin"}],")."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Light and Sun:"}]," Concepts symbolizing brightness and brilliance, such as sunrise (",["$","a","a-0",{"href":"/en/name/rojda","children":"Rojda"}],"), daylight (",["$","a","a-1",{"href":"/en/name/rojin","children":"Rojîn"}],"), or golden sun (",["$","a","a-2",{"href":"/en/name/rozerin","children":"Rozerîn"}],")."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Love and Life:"}]," Compassionate and vital themes like love (",["$","a","a-0",{"href":"/en/name/evin","children":"Evîn"}],"), life-giver (",["$","a","a-1",{"href":"/en/name/jinda","children":"Jînda"}],"), or my soul/bosom (",["$","a","a-2",{"href":"/en/name/sinem","children":"Sînem"}],")."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Willpower and Freedom:"}]," Names representing strong stands, such as determination (",["$","a","a-0",{"href":"/en/name/viyan","children":"Viyan"}],"), will (",["$","a","a-1",{"href":"/en/name/vin","children":"Vîn"}],"), or independence (",["$","a","a-2",{"href":"/en/name/sarya","children":"Sarya"}],")."]}],"\n"]}]
