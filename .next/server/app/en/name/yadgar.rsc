1d:["$","div","10",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Does Yadgar appear in mythology or literary sources?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Names like Yadgar have long been used in Kurdish epics and poetic tradition. Classical Kurdish works, most notably Mem û Zîn, feature such names both as character names and as poetic symbols carrying deep meaning."}]]}]
1e:["$","div","11",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Can non-Kurdish speakers easily pronounce Yadgar?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"The name Yadgar is largely compatible with English and other European phonetic systems. Containing no special characters, this name can be easily pronounced by non-Kurdish speakers."}]]}]
1f:["$","div","12",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Are there nicknames or affectionate forms of Yadgar?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Affectionate short forms of Yadgar vary by family. It can often be shortened to \"Yad\", or affectionate suffixes such as \"-ko\" or \"-jan\" may be added."}]]}]
20:["$","div","13",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"Is the name Yadgar used outside of Kurdish communities?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Yadgar is widely used in regions where Kurds live, including Turkey, Iraq, Iran and Syria. It also attracts attention in Kurdish diaspora communities in Europe. "}]]}]
21:["$","div","14",{"style":{"background":"var(--surface)","border":"1px solid var(--border)","borderRadius":"var(--r-lg)","padding":"1.15rem 1.25rem"},"children":[["$","h3",null,{"style":{"fontSize":"0.975rem","fontWeight":700,"color":"var(--text)","margin":"0 0 0.45rem 0"},"children":"How do linguists assess the name Yadgar?"}],["$","p",null,{"style":{"fontSize":"0.875rem","lineHeight":1.7,"color":"var(--text-muted)","margin":0},"children":"Linguists describe Yadgar as phonetically rich and fluid. As a notable example of the Kurdish lexical heritage, this name showcases the beauty of the Kurdish phonetic harmony system."}]]}]
